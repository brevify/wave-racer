{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/health", "destination": "/api/health" },
    { "source": "/api/tides", "destination": "/api/tides" },
    { "source": "/api/uv", "destination": "/api/uv" },
    { "source": "/api/heat-stress", "destination": "/api/heat-stress" },
    { "source": "/api/wind-direction", "destination": "/api/wind-direction" },
    { "source": "/api/wind-speed", "destination": "/api/wind-speed" },
    { "source": "/api/NEA", "destination": "/api/NEA" }
  ]
}
